# Auth (Auth.js v5 — use AUTH_SECRET; NEXTAUTH_SECRET é aceito por compatibilidade)
AUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Database (Vercel Postgres - auto-injected in Vercel)
# For local development, use a local Postgres or Neon
DATABASE_URL="postgresql://user:password@localhost:5432/calculadora?schema=public"

# KV (Vercel KV - auto-injected in Vercel)
# For local development, use Upstash Redis or local Redis
KV_REST_API_URL="http://localhost:8079"
KV_REST_API_TOKEN="your-kv-token"

# Email (optional - for magic links)
EMAIL_SERVER_HOST="smtp.sendgrid.net"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="your-sendgrid-api-key"
EMAIL_FROM="noreply@seudominio.com"

# CNPJ.io token (optional - fallback for CNPJ lookup)
CNPJ_IO_TOKEN="your-cnpj-io-token"