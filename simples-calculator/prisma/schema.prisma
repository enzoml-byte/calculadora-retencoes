generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Empresa {
  id            String       @id @default(cuid())
  razaoSocial   String
  nomeFantasia  String?
  cnpj          String       @unique
  dataCadastro  DateTime     @default(now())
  ativo         Boolean      @default(true)
  apuracoes     Apuracao[]

  @@index([cnpj])
  @@index([ativo])
}

model Apuracao {
  id                    String       @id @default(cuid())
  empresaId             String
  empresa               Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodoApuracao       DateTime     // Primeiro dia do mês (00:00:00)
  receitaBrutaMes       Float
  rbt12InformadoPgdas   Float?
  rbt12CalculadoSistema Float?
  anexo                 String       // III, IV, V
  aliquotaNominal       Float
  parcelaDeduzir        Float
  aliquotaEfetiva       Float
  valorDas              Float
  arquivoOriginal       String?
  dataImportacao        DateTime     @default(now())
  observacoes           String?
  versaoRegra           String       // Versão das regras tributárias usadas
  substituidaPorId      String?      @unique
  substituicaoDe        Apuracao?    @relation("Retificacao", fields: [substituidaPorId], references: [id], onDelete: Cascade)
  retificacoes          Apuracao[]   @relation("Retificacao")

  @@unique([empresaId, periodoApuracao])
  @@index([empresaId, periodoApuracao])
  @@index([periodoApuracao])
}

model TaxRule {
  id              String    @id @default(cuid())
  anexo           String    // III, IV, V
  faixa           Int
  limiteInferior  Float
  limiteSuperior  Float?    // null = sem teto
  aliquotaNominal Float
  parcelaDeduzir  Float
  vigenciaInicio  DateTime
  vigenciaFim     DateTime?
  versao          String
  createdAt       DateTime  @default(now())

  @@index([anexo, vigenciaInicio])
  @@index([versao])
}