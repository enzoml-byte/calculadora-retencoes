// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  empresas      Empresa[]
  notas         Nota[]
  conciliacoes  Conciliacao[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Empresa {
  id                String    @id @default(cuid())
  userId            String
  cnpj              String    @unique
  razaoSocial       String
  nomeFantasia      String?
  regime            Regime    @default(PRESUMIDO_GERAL)
  anexo             Anexo?    // III, IV, V (only for SIMPLES)
  rbt12             Decimal?  @db.Decimal(15,2)
  issRetido         IssRetido @default(SEMPRE)
  informaIbsCbs     Boolean   @default(true)
  dadosCnpj         Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notas             Nota[]

  @@index([userId])
  @@index([cnpj])
}

model Nota {
  id                    String   @id @default(cuid())
  empresaId             String
  userId                String
  numeroNf              String?
  serie                 String?
  valorBruto            Decimal  @db.Decimal(15,2)
  regime                Regime   @default(PRESUMIDO_GERAL)
  retencoes             Json     // {ir, pis, cofins, csll, iss, totalFederal, totalGeral, liquido, ibs, cbs}
  aliquotaEfetivaSimples Decimal? @db.Decimal(10,8) // 8 casas para Simples
  emitidaEm             DateTime @default(now())
  xmlNfe                String?  @db.Text
  createdAt             DateTime @default(now())

  empresa               Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conciliacoes          Conciliacao[]

  @@index([empresaId])
  @@index([userId])
  @@index([emitidaEm])
}

model Conciliacao {
  id               String        @id @default(cuid())
  notaId           String?
  userId           String
  contaBancaria    String?
  dataLancamento   DateTime      @db.Date
  valor            Decimal       @db.Decimal(15,2)
  descricao        String?
  status           ConcStatus    @default(PENDENTE)
  observacao       String?
  createdAt        DateTime      @default(now())

  nota             Nota?         @relation(fields: [notaId], references: [id], onDelete: SetNull)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notaId])
  @@index([userId, dataLancamento])
  @@index([status])
}

enum Role {
  ADMIN
  USER
}

enum Regime {
  SIMPLES
  PRESUMIDO_GERAL
  PRESUMIDO_HOSPITALAR
}

enum Anexo {
  III
  IV
  V
}

enum IssRetido {
  SEMPRE
  NUNCA
  PERGUNTAR
}

enum ConcStatus {
  PENDENTE
  CONCILIADO
  DIVERGENTE
}