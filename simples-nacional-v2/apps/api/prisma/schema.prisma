generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           String     @id @default(cuid())
  razaoSocial  String
  nomeFantasia String?
  cnpj         String     @unique
  dataCadastro DateTime   @default(now())
  ativo        Boolean    @default(true)
  apuracoes    Apuracao[]
}

model Apuracao {
  id                   String   @id @default(cuid())
  empresaId            String
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodoApuracao      String
  receitaBrutaMes      Float
  rbt12InformadoPgdas  Float?
  rbt12Calculado       Float
  anexo                String
  aliquotaNominal      Float
  parcelaDeduzir       Float
  aliquotaEfetiva      Float
  valorDAS             Float
  arquivoOriginal      String?
  observacoes          String?
  versaoRegra          String
  substituidaPorId     String?
  dataImportacao       DateTime @default(now())

  @@index([empresaId, periodoApuracao])
  // Unicidade entre nao-retificadas garantida por indice parcial na migration
  // 02_partial_unique (WHERE substituidaPorId IS NULL). SQLite trata NULL como
  // distinto, entao @@unique com nullable nao serviria.
}

model TaxRule {
  id             String  @id @default(cuid())
  anexo          String
  faixa          Int
  limiteInferior Float
  limiteSuperior Float?
  aliquotaNominal Float
  parcelaDeduzir Float
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  versao         String

  @@unique([anexo, faixa, versao])
}
